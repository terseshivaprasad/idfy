<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting (ASP.NET Core Module, in-process). `dotnet publish` rewrites the handler/path,
  but keeps these attributes:
    shutdownTimeLimit - seconds IIS waits for graceful shutdown on stop / app-pool recycle.
                        Keep it >= the host ShutdownTimeoutSeconds (default 25) so the log
                        writer can drain its queue before the worker is killed.
    hostingModel      - in-process for best performance.
  Configure the app pool separately (see notes) to avoid frequent recycles.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\Idfy.Api.dll"
                  stdoutLogEnabled="false"
                  hostingModel="inprocess"
                  shutdownTimeLimit="30"
                  startupTimeLimit="120" />
    </system.webServer>
  </location>
</configuration>
