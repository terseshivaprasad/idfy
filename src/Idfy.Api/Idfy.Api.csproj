<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>fd7e6acc-ec94-48d0-a89c-b8d282014323</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Update="web.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- Development-only browser test pages: served by `dotnet run`, never published. -->
    <Content Update="wwwroot\test\**" CopyToPublishDirectory="Never" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />
  </ItemGroup>

</Project>
